# Brevo (Sendinblue) SMTP relay credentials
# Get these from Brevo dashboard -> SMTP & API -> SMTP tab
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# The "From" address (must be a verified sender in your Brevo account)
SENDER_EMAIL=

# Where contact-form submissions are delivered
CONTACT_TO_EMAIL=3ssafestorage@gmail.com

# Local server port
PORT=3000
